@model IEnumerable<Order>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "訂單";
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">訂單查詢</h1>
</div>
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0 admin-table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m=>m.order_id)</th>
                <th>@Html.DisplayNameFor(m=>m.total_price)</th>
                <th>@Html.DisplayNameFor(m => m.created_at)</th>
                @if (ViewBag.permissionCodes.Contains("Order.Detail"))
                {
                    <th>操作</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.order_id</td>
                    <td>NT$ @item.total_price</td>
                    <td>@item.created_at</td>
                    @if (ViewBag.permissionCodes.Contains("Order.Detail"))
                    {
                    <td class="text-nowrap">
                        <div class="d-flex justify-content-center align-items-center gap-1">
                            <a class="btn btn-warning" asp-action="Detail" asp-route-id="@item.order_id">訂單詳情</a>
                        </div>
                    </td>
                    }
                </tr>
            }
        </tbody>
        </table>
    </div>
</div>