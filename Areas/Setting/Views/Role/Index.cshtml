@model IEnumerable<BackOffice.Areas.Setting.Models.Role>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">角色管理</h1>
</div>

    @if (ViewBag.permissionCodes.Contains("Role.Create")){
        <p>
    <a asp-area="Setting"
   asp-controller="Role"
   asp-action="Create" class="btn btn-warning">新增</a>
</p>
    }

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0 admin-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.role_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.created_at)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.updated_at)
            </th>
            @if (ViewBag.permissionCodes.Contains("Role.Edit") || ViewBag.permissionCodes.Contains("Role.Delete"))
            {
                <th>操作</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.role_name
                </td>
                <td>
                    @item.description
                </td>
                <td>
                    @item.created_at
                </td>
                <td>
                    @item.updated_at
                </td>
                @if (ViewBag.permissionCodes.Contains("Role.Edit") || ViewBag.permissionCodes.Contains("Role.Delete"))
                {
                    <td class="text-nowrap">
                        <div class="d-flex justify-content-center align-items-center gap-1">
                            @if (ViewBag.permissionCodes.Contains("Role.Edit"))
                            {
                                <a asp-action="Permissions"
                                    asp-route-id="@item.role_id"
                                    class="btn btn-primary">權限設置</a>

                                <a asp-action="Edit"
                                    asp-route-id="@item.role_id"
                                    class="btn btn-success">編輯</a>
                            }

                            @if (ViewBag.permissionCodes.Contains("Role.Delete"))
                            {
                                <form asp-action="Delete"
                                        asp-route-id="@item.role_id"
                                        method="post"
                                        onsubmit="send(event)">
                                    <button type="submit" class="btn btn-danger">刪除</button>
                                </form>
                            }
                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
    </div>
</div>
@section Scripts{

<script>
    let m ='@Html.Raw(TempData["Message"])'
    if (m){
        alert (m);
    }
    function send(e){
        if(!confirm('確定要刪除嗎?')){
            e.preventDefault();
        }
    }
</script>
}