@model IEnumerable<BackOffice.Areas.Setting.Models.ViewModel.UserIndexViewModel>
@using System.Text.Json;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">帳號管理</h1>
</div>
@if (ViewBag.permissionCodes.Contains("User.Create"))
{
    <p>
        <a asp-area="Setting"
       asp-controller="User"
       asp-action="Create" class="btn btn-warning">新增</a>
    </p>
}
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0 admin-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.user_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.created_at)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.updated_at)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.last_login_at)
            </th>
            <th>
                @Html.DisplayNameFor(model=>model.role_name)
            </th>
            @if(ViewBag.permissionCodes.Contains("User.Edit") || ViewBag.permissionCodes.Contains("User.Delete"))
            {
                <th>操作</th>
                
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.status==0?"table-secondary":"")">
                <td>
                    @item.user_name
                </td>
                <td>
                    @if (item.status == 1)
                    {
                        @: 啟用
                    }
                    else
                    {
                        @: 未啟用
                    }
                </td>
                <td>
                    @item.created_at
                </td>
                <td>
                    @item.updated_at
                </td>
                <td>
                    @if (item.last_login_at==null){
                        @:尚未登入
                    }else{
                    @item.last_login_at
                    }
                </td>
                <td>
                    @item.role_name
                </td>
                @if(ViewBag.permissionCodes.Contains("User.Edit") || ViewBag.permissionCodes.Contains("User.Delete"))
                {
                <td class="text-nowrap">
                    <div class="d-flex justify-content-center align-items-center gap-1">

                    @if(ViewBag.permissionCodes.Contains("User.Edit")){
                        <a asp-action="Edit" asp-route-id="@item.user_id" class="btn btn-success">編輯</a>
                    }
                    @if(ViewBag.permissionCodes.Contains("User.Delete")){
                        <form asp-action="Delete" asp-route-id="@item.user_id" method="post" onsubmit="send(event)">
                            <button type="submit" class="btn btn-danger">刪除</button>
                        </form>
                    }
                    </div>
                </td>
                }
            </tr>
        }
    </tbody>
</table>
</div>
</div>

@section Scripts{

<script>
    let m = @Html.Raw(JsonSerializer.Serialize(TempData["Message"]));
    if (m){
        alert(m);
    }
    function send(e){
            if (!confirm('確定要刪除嗎?')){
                e.preventDefault();
            }
    }
</script>
} 
